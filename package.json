{
  "name": "examme",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "npm run web:dev",
    "build": "npm run web:build && npm run api:build",
    "lint": "eslint web-lambda/src api-lambda/src --ext ts --report-unused-disable-directives --max-warnings 0",
    "start": "npm run web:start",
    "test:functional": "jest --config=jest.functional.config.ts --runInBand",
    "api:dev": "nodemon --legacy-watch --ext ts,js,json --watch api-lambda/src --watch shared --exec \"ts-node -P api-lambda/tsconfig.json -r tsconfig-paths/register api-lambda/src/server.ts\"",
    "api:build": "tsc -p api-lambda/tsconfig.json",
    "api:start": "node api-lambda/dist/api-lambda/src/server.js",
    "web:dev": "nodemon --legacy-watch --ext ts,js,json,html --watch web-lambda/src --watch web-lambda/templates --watch shared --exec \"ts-node -P web-lambda/tsconfig.json web-lambda/src/server.ts\"",
    "web:build": "tsc -p web-lambda/tsconfig.json",
    "web:start": "node web-lambda/dist/web-lambda/src/local.js",
    "format": "prettier \"**/*.{ts,js,json,html,css,md,yml,yaml}\" --write",
    "format:check": "prettier \"**/*.{ts,js,json,html,css,md,yml,yaml}\" --check"
  },
  "dependencies": {
    "@vendia/serverless-express": "^4.12.6",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.6",
    "bson": "^5.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nunjucks": "^3.2.4",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "serverless-http": "^3.2.0",
    "typedi": "^0.10.0",
    "typeorm": "^0.3.31",
    "winston": "^3.19.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@jest/expect": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "serverless-plugin-typescript": "^2.1.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.11",
    "ts-jest-mock-import-meta": "^1.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "description": ""
}
